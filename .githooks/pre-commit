#!/bin/zsh
# Fast module guards (no compiler) before every commit: tools/check_modules.sh fast.
# They check the working tree, so unstaged fixes count too; run_mode2 checks again before push.
# A failing check means the code changes, not the check; never commit with --no-verify (AGENTS.md "Module rules").
cd "$(git rev-parse --show-toplevel)" || exit 1
zsh tools/check_modules.sh fast || { echo "pre-commit: module guards failed; commit refused" >&2; exit 1 }
