== claude folder
result: captured
exec: <cli>
arg: "-p"
arg: "--tools"
arg: "Read,Grep,Glob"
arg: "--no-session-persistence"
arg: "--strict-mcp-config"
arg: "--mcp-config"
arg: "{\"mcpServers\":{\"illuminati\":{\"args\":[\"$RESOURCES\\/workspace_mcp.py\",\"$TEST_HOME\\/.ai-illuminati\\/rooms\\/<uuid>\\/stateless-<uuid>\\/workspace-<uuid>.json\"],\"command\":\"\\/usr\\/bin\\/python3\",\"timeout\":3610000}}}"
arg: "--no-chrome"
arg: "--restricted"
arg: "--setting-sources"
arg: ""
arg: "--disable-slash-commands"
arg: "--permission-mode"
arg: "dontAsk"
arg: "--allowedTools"
arg: "Read,Grep,Glob,mcp__illuminati__*"
arg: "--add-dir"
arg: "$TEST_HOME/run-conditions-root"
dir: $TEST_HOME/.ai-illuminati/rooms/<uuid>/stateless-<uuid>
group: false
== claude folder-full
result: captured
exec: <cli>
arg: "-p"
arg: "--tools"
arg: "default"
arg: "--no-session-persistence"
arg: "--strict-mcp-config"
arg: "--mcp-config"
arg: "{\"mcpServers\":{\"illuminati\":{\"args\":[\"$RESOURCES\\/workspace_mcp.py\",\"$TEST_HOME\\/.ai-illuminati\\/rooms\\/<uuid>\\/stateless-<uuid>\\/workspace-<uuid>.json\"],\"command\":\"\\/usr\\/bin\\/python3\",\"timeout\":3610000}}}"
arg: "--no-chrome"
arg: "--setting-sources"
arg: ""
arg: "--disable-slash-commands"
arg: "--permission-mode"
arg: "bypassPermissions"
arg: "--disallowedTools"
arg: "Bash(git push:*),Bash(git filter-branch:*),Bash(git filter-repo:*),Bash(/usr/bin/git push:*),Bash(gh repo delete:*),Bash(/bin/rm:*),Bash(git clean:*),Bash(/usr/bin/security:*)"
arg: "--add-dir"
arg: "$TEST_HOME/run-conditions-root"
dir: $TEST_HOME/.ai-illuminati/rooms/<uuid>/stateless-<uuid>
group: false
env+: GH_CONFIG_DIR="$TEST_HOME/Library/Application Support/AI Illuminati/auto-guard/gh-empty"
env-: GH_TOKEN
env+: GIT_ASKPASS="/usr/bin/false"
env+: GIT_CONFIG_COUNT="2"
env+: GIT_CONFIG_KEY_0="credential.helper"
env+: GIT_CONFIG_KEY_1="credential.https://github.com.helper"
env+: GIT_CONFIG_VALUE_0=""
env+: GIT_CONFIG_VALUE_1=""
env+: GIT_SSH_COMMAND="/usr/bin/ssh -o BatchMode=yes -o IdentitiesOnly=yes -i /dev/null"
env+: GIT_TERMINAL_PROMPT="0"
env+: PATH="$TEST_HOME/Library/Application Support/AI Illuminati/auto-guard/bin:${PATH}"
env+: SSH_ASKPASS="/usr/bin/false"
env-: SSH_AUTH_SOCK
